---
import type { Categoria } from "@types";
import Layout from "../layouts/Layout.astro";
import HeroSubpages from "../components/shared/HeroSubpage.astro";
import { requester } from "../scripts/api/api.js";
const categoriasItemMenu: Categoria[] = await requester(
  "/enums/categorias-item-menu",
);
---

<Layout pageTitle="Menu">
  <HeroSubpages
    textTitle="Nosso <span>Menu</span>/<span>Cardápio</span>"
    textDescription="Da coquetelaria autoral aos petiscos irresistíveis, tudo aqui foi feito pra combinar com boas conversas e risadas sinceras."
  />
  <section class="bg-(--white) py-24 px-0">
    <div class="flex justify-center gap-10">
      <a class="btn-default btn-primary btn-category" id="todos">
        Todos os itens
      </a>
      {
        categoriasItemMenu?.map((categoria: Categoria) => (
          <a
            class="btn-default btn-primary btn-category"
            data-category={categoria.valor}
          >
            {categoria.descricao}
          </a>
        ))
      }
    </div>
    <div id="menu-itens-root" class="container grid gap-10 items-start"></div>
  </section>
</Layout>

<script>
  import { requester } from "../scripts/api/api";
  import { renderItems } from "../scripts/api/buildMenuItens";

  renderItems(await requester("/menu-itens"));

  const categoryButtons = document.querySelectorAll(".btn-category");
  categoryButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const categoryValue = button.getAttribute("data-category");
      if (categoryValue === null) {
        renderItems(await requester(`/menu-itens`));
        return;
      }
      renderItems(await requester(`/menu-itens/categoria/${categoryValue}`));
    });
  });
</script>
