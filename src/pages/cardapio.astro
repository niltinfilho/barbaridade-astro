---
import type { Categoria } from "@types";
import Layout from "../layouts/Layout.astro";
import HeroSubpages from "../components/shared/HeroSubpage.astro";
import BtnDefault from "../components/shared/BtnDefault.astro";
import { requester } from "../scripts/api/api.js";
const categoriasItemMenu: Categoria[] = await requester(
  "/enums/categorias-item-menu",
);
---

<Layout pageTitle="Menu">
  <HeroSubpages
    textTitle="Nosso <span>Menu</span>/<span>Cardápio</span>"
    textDescription="Da coquetelaria autoral aos petiscos irresistíveis, tudo aqui foi feito pra combinar com boas conversas e risadas sinceras."
  />
  <section id="menu-section">
    <div class="categorias">
      <a class="btn-default btn-primary btn-category" id="todos">
        Todos os itens
      </a>
      {
        categoriasItemMenu?.map((categoria: Categoria) => (
          <a
            class="btn-default btn-primary btn-category"
            data-category={categoria.valor}
          >
            {categoria.descricao}
          </a>
        ))
      }
    </div>
    <div class="menu-grid container"></div>
  </section>

  <style>
    #menu-section {
      background-color: var(--white);
      padding: 96px 0;

      .categorias {
        display: flex;
        justify-content: center;
        gap: 40px;
      }

      .menu-grid {
        display: grid;
        gap: 40px;
        align-items: start;

        .section {
          h2 {
            font-size: 48px;
            font-weight: 600;
            text-align: center;
            text-transform: uppercase;
            color: var(--primary-color);
            margin: 96px 0 64px;
          }

          .cards {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 80px;

            .card {
              background: var(--secondary-color);
              border-radius: 16px;
              padding: 12px 12px 24px;
              text-align: center;
              color: white;

              img {
                width: 100%;
                border-radius: 14px;
              }

              h3 {
                font-weight: 600;
                font-size: 24px;
                letter-spacing: 0.2px;
                margin: 16px 0 12px;
              }

              p {
                font-size: 14px;
              }
            }
          }
        }

        @media (max-width: 1280px) {
          .menu-grid {
            .section {
              h2 {
                font-size: 36px;
                margin: 80px 0 64px;
              }

              .cards {
                display: grid;
                grid-template-columns: 1fr 1fr;

                .card {
                  h3 {
                    font-size: 20px;
                  }
                }
              }
            }
          }
        }

        @media (max-width: 720px) {
          .menu-grid {
            gap: 24px;

            .section {
              h2 {
                font-size: 24px;
              }

              .cards {
                display: grid;
                grid-template-columns: 1fr;
                gap: 40px;

                .card {
                  h3 {
                    font-size: 18px;
                  }

                  p {
                    font-size: 12px;
                  }
                }
              }
            }
          }
        }
      }
    }

    @media (max-width: 1280px) {
      #menu-section {
        background-color: var(--white);
        padding: 64px 16px;

        .categorias {
          flex-wrap: wrap;
          gap: 24px;
        }
      }
    }

    @media (max-width: 720px) {
      #menu-section {
        .categorias {
          gap: 16px;
          font-size: 14px;
        }
      }
    }
  </style>
</Layout>

<script>
  import { requester } from "../scripts/api/api";
  import { renderItems } from "../scripts/api/buildMenuItens";

  renderItems(await requester("/menu-itens"));

  const categoryButtons = document.querySelectorAll(".btn-category");
  categoryButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const categoryValue = button.getAttribute("data-category");
      if (categoryValue !== null) {
        renderItems(await requester(`/menu-itens/categoria/${categoryValue}`));
      } else {
        renderItems(await requester(`/menu-itens`));
      }
    });
  });
</script>
