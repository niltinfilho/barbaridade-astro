---
import Menu from "../components/Menu.astro";
import BtnDefault from "../components/shared/BtnDefault.astro";
import Sobre from "../components/Sobre.astro";
import Layout from "../layouts/Layout.astro";
import imgHero1 from "../assets/banner-bar-baridade-1.jpg";
import imgHero2 from "../assets/banner-bar-baridade-2.jpg";
import imgHero3 from "../assets/banner-bar-baridade-3.jpg";
import imgHero4 from "../assets/banner-bar-baridade-4.jpg";
import imgCalendario from "../assets/banda-tocando-no-bar.jpg";

const images = [
  {
    imageUrl: `${imgHero1.src}`,
    description: "Vista interna do Bar-Baridade com ambiente iluminado e mesas",
  },
  {
    imageUrl: `${imgHero2.src}`,
    description: "Bar-Baridade à noite com decoração sofisticada",
  },
  {
    imageUrl: `${imgHero3.src}`,
    description: "Drinks e petiscos servidos no Bar-Baridade",
  },
  {
    imageUrl: `${imgHero4.src}`,
    description: "Balcão do Bar-Baridade com atendimento personalizado",
  },
];
---

<Layout pageTitle="O Único Lugar Onde o Charme é Destilado">
  <section id="hero-section" aria-label="Banner principal do Bar-Baridade">
    <div class="swiper swiper-hero-section">
      <div class="swiper-wrapper">
        {
          images.map((img) => (
            <div class="swiper-slide" role="img" aria-label={img.description}>
              <div
                class="swiper-img"
                style={`background-image: url(${img.imageUrl});`}
                aria-hidden="true"
              />
              <div class="swiper-overlay" aria-hidden="true" />
            </div>
          ))
        }
      </div>
    </div>
    <div class="slider-text flex">
      <h1>
        O <span>ÚNICO</span> LUGAR <br />
        ONDE O CHARME É <span>DESTILADO</span>
      </h1>
      <BtnDefault label="Reserve Agora" className="nav-menu-button" />
      <p>Av. das Boas Noites, 123 – Bairro Alto da Lua, São Paulo – SP</p>
    </div>
  </section>
  <Sobre />
  <Menu />
  <section class="flex" id="calendario-section" aria-labelledby="calendario-titulo">
    <div
      class="img-calendario"
      style={`background-image: url(${imgCalendario.src});`}
    >
    </div>
    <div class="text-calendario">
      <h2 id="calendario-titulo">Calendário de Shows</h2>
      <h3>Dezembro 2025</h3>
      <div class="bandas-calendario">
        <div>
          <p class="calendario-banda-title">
            <span>Quinta • 06/12</span> - “Os Bons de Copo”
          </p>
          <p class="calendario-banda-desc">
            Jazz, bossa e improviso pra quem entende que ritmo também se bebe.
          </p>
        </div>
        <div>
          <p class="calendario-banda-title">
            <span>Sexta • 07/12</span> - “Vintage 82”
          </p>
          <p class="calendario-banda-desc">
            Rock clássico com alma jovem e solos que combinam com whisky on the
            rocks.
          </p>
        </div>
        <div>
          <p class="calendario-banda-title">
            <span>Sábado • 08/12</span> - “Marina & Os Destemperados”
          </p>
          <p class="calendario-banda-desc">
            MPB moderna e risadas entre um gole e outro.
          </p>
        </div>
        <BtnDefault label="Ver todos os eventos" ref="calendario" colorScheme="tertiary" />
      </div>
    </div>
  </section>
  <section class="iframe-maps" aria-label="Localização do Bar-Baridade no mapa">
    <div>
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d467688.89495119266!2d-46.5952992!3d-23.6824124!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce448183a461d1%3A0x9ba94b08ff335bae!2zU8OjbyBQYXVsbywgU1A!5e0!3m2!1spt-BR!2sbr!4v1764451555763!5m2!1spt-BR!2sbr"
        width="100%"
        height="450"
        style="border: 0"
        allowfullscreen=""
        loading="lazy"
        title="Localização do Bar-Baridade no Google Maps"
        aria-label="Mapa mostrando a localização do Bar-Baridade em São Paulo"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Layout>

<style>
  #hero-section {
    position: relative;

    .swiper {
      .swiper-img {
        width: 100vw!;
        height: 100vh;
        background-position: center center;
        background-size: cover;
        background-repeat: no-repeat;
      }
      .swiper-overlay {
        width: 100vw;
        height: 100vh;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0.93;
        background-image: radial-gradient(circle, #000000c3, #00000085);
      }
    }

    .slider-text {
      position: absolute;
      top: 35%;
      width: 100%;
      z-index: 3;
      text-align: center;
      flex-direction: column;
      gap: 48px;
      color: var(--white);

      h1 {
        font-size: 5rem;
        color: var(--white);
      }

      span {
        color: var(--primary-color);
      }

      a {
        padding: 16px 48px;
      }

      p {
        font-size: 1.125rem;
      }
    }
  }

  .iframe-maps {
    padding: 96px 0;
    background-color: var(--white);

    div {
      max-width: 960px;
      margin: 0 auto;

      iframe {
        border-radius: 12px;
      }
    }
  }

  #calendario-section {
    width: 100%;

    .img-calendario {
      width: 50%;
      height: 90vh;
      background-position: center center;
      background-repeat: no-repeat;
      background-size: cover;
    }

    .text-calendario {
      width: 50%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      h2 {
        font-size: 3rem;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--primary-color);
        margin-bottom: 12px;
      }

      h3 {
        font-size: 2rem;
        font-weight: 600;
        color: var(--white);
        margin-bottom: 70px;
      }

      .bandas-calendario {
        color: var(--white);
        display: flex;
        flex-direction: column;
        gap: 40px;
        align-items: flex-start;

        div {
          display: flex;
          flex-direction: column;
          gap: 12px;

          .calendario-banda-title {
            font-weight: 600;
            font-size: 1.25rem;

            span {
              text-decoration: underline;
            }
          }
        }
      }
    }
  }

  @media (max-width: 1280px) {
    #hero-section {
      .slider-hero-1 {
        height: 80vh !important;
      }

      .slider-hero-2 {
        height: 80vh !important;
      }

      .slider-hero-3 {
        height: 80vh !important;
      }

      .slider-hero-4 {
        height: 80vh !important;
      }

      .slider-text {
        top: 35%;
        padding: 0 16px;

        h1 {
          font-size: 3rem;
        }

        p {
          font-size: 1rem;
        }
      }
    }

    #calendario-section {
      flex-direction: column;

      .img-calendario {
        width: 100%;
        height: 40vh;
      }

      .text-calendario {
        width: 100%;
        padding: 64px 16px;

        h2 {
          font-size: 2.25rem;
        }

        h3 {
          font-size: 1.5rem;
        }
      }
    }

    .iframe-maps {
      padding: 64px 16px;
    }
  }

  @media (max-width: 720px) {
    #hero-section {
      .slider-text {
        top: 35%;
        gap: 32px;

        h1 {
          font-size: 2rem;
        }

        p {
          font-size: 0.875rem;
        }
      }
    }

    #calendario-section {
      .text-calendario {
        h2 {
          font-size: 1.5rem;
        }

        h3 {
          font-size: 1.125rem;
        }

        .bandas-calendario {
          div {
            display: flex;
            flex-direction: column;
            gap: 12px;

            .calendario-banda-title {
              font-weight: 600;
              font-size: 1rem;
            }

            .calendario-banda-desc {
              font-size: 0.875rem;
            }
          }
        }
      }
    }
  }
</style>

<script>
  import Swiper from "swiper/bundle";
  new Swiper(".swiper-hero-section", {
    spaceBetween: 0,
    centeredSlides: true,
    autoplay: {
      delay: 2500,
      disableOnInteraction: false,
    },
    loop: true,
  });
</script>
