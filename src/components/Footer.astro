---
import BtnDefault from "./shared/BtnDefault.astro";
import logoBarBaridade from "../assets/id/logo-bar-baridade-horizontal-original.svg";
import bannerFooter from "../assets/banner-bar-baridade-footer.jpg";
const bgImage = `url(${bannerFooter.src})`;
const base = import.meta.env.BASE_URL;
---

<footer id="footer" role="contentinfo">
  <section class="cta-footer" aria-labelledby="cta-footer-titulo">
    <h2 id="cta-footer-titulo">Viva a experiência Bar-Baridade</h2>
    <p>
      No Bar-Baridade, cada noite é um convite pra brindar o que a vida tem de
      melhor: boa música, bons drinks e boas risadas. Aqui, a sofisticação tem
      sabor, e o humor é o ingrediente secreto de cada receita.
    </p>
    <BtnDefault label="Fazer reserva agora" />
  </section>

  <section class="info-footer container" aria-label="Informações do Bar-Baridade">
    <div class="flex info-footer-top">
      <img src={logoBarBaridade.src} alt="Logo Bar-Baridade" width="240" height="auto" />

      <address aria-label="Informações de Contato">
        <h2>Informações de Contato</h2>
        <ul role="list">
          <li role="listitem">
            <a
              href="https://maps.google.com/?q=Av.+das+Boas+Noites+123+São+Paulo+SP"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Endereço: Av. das Boas Noites, 123, Bairro Alto da Lua, São Paulo – Abrir no Google Maps"
              tabindex="0"
            >
              Av. das Boas Noites, 123 <br />
              Bairro Alto da Lua, São Paulo – SP
            </a>
          </li>
          <li role="listitem">
            <a href="tel:+5511999999999" aria-label="Telefone: (11) 99999-9999" tabindex="0">
              (11) 99999-9999
            </a>
          </li>
          <li role="listitem">
            <a
              href="https://instagram.com/bar_baridade.sp"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram: @bar_baridade.sp (abre em nova aba)"
              tabindex="0"
            >
              @bar_baridade.sp
            </a>
          </li>
        </ul>
      </address>

      <nav aria-label="Links importantes do rodapé">
        <h2>Links Importantes</h2>
        <ul role="list">
          <li role="listitem"><a href={`${base}/sobre`} tabindex="0">Sobre</a></li>
          <li role="listitem"><a href={`${base}/menu`} tabindex="0">Menu</a></li>
          <li role="listitem"><a href={`${base}/calendario`} tabindex="0">Calendário</a></li>
          <li role="listitem"><a href={`${base}/reserva`} tabindex="0">Fazer reserva</a></li>
        </ul>
      </nav>
    </div>

    <div class="flex info-footer-bottom">
      <p>&copy; 2026 Bar-Baridade. Todos os direitos reservados.</p>
      <p>
        <a href="#" tabindex="0">Política de Privacidade</a> | <a href="#" tabindex="0">Termos de Uso</a>
      </p>
    </div>
  </section>
</footer>

<style define:vars={{ bgImage }}>
  footer {
    background-color: #0f0f0f;

    .cta-footer {
      padding: 96px 0;
      background: var(--bgImage) center center no-repeat;
      background-size: cover;
      text-align: center;

      h2 {
        font-size: 3rem;
        font-weight: 600;
        color: var(--white);
        margin-bottom: 16px;
        text-transform: uppercase;
      }

      p {
        color: var(--white);
        max-width: 670px;
        margin: 0 auto;
      }

      a {
        display: block;
        margin: 40px auto 0;
        width: fit-content;
      }
    }

    .info-footer {
      padding: 96px 0 40px;

      .info-footer-top {
        justify-content: space-between;
        align-items: flex-start;

        img {
          width: 240px;
        }

        h2 {
          color: var(--white);
          font-size: 1.25rem;
          margin-bottom: 24px;
        }

        address {
          font-style: normal;
        }

        ul {
          li,
          a {
            color: var(--white);
            transition: all 0.2s;
            padding: 8px 0;
            display: block;
          }

          a:hover {
            color: var(--primary-color);
          }
        }
      }

      .info-footer-bottom {
        justify-content: space-between;
        margin-top: 80px;

        p,
        a {
          color: var(--white);
          transition: all 0.2s;
          padding: 8px 0;
        }

        a:hover {
          color: var(--primary-color);
        }
      }
    }
  }

  @media (max-width: 1280px) {
    footer {
      .cta-footer {
        padding: 64px 16px;

        h2 {
          font-size: 2.25rem;
        }
      }

      .info-footer {
        padding: 64px 16px 40px;

        .info-footer-top {
          justify-content: space-between;
          align-items: flex-start;

          img {
            width: 200px;
          }

          h2 {
            font-size: 1.125rem;
          }
        }

        .info-footer-bottom {
          margin-top: 64px;
        }
      }
    }
  }

  @media (max-width: 720px) {
    footer {
      .cta-footer {
        h2 {
          font-size: 1.5rem;
        }

        a {
          margin: 24px auto 0;
        }
      }

      .info-footer {
        .info-footer-top {
          gap: 40px;

          img {
            width: 180px;
          }
        }

        .info-footer-bottom {
          align-items: center;
          text-align: center;
          margin-top: 40px;
        }
      }
    }
  }
</style>
