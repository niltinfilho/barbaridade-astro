---
import logoBarBaridade from "../assets/id/logo-bar-baridade-horizontal-original.svg";
import BtnDefault from "./shared/BtnDefault.astro";
const base = import.meta.env.BASE_URL;
---

<header role="banner">
  <div class="container flex">
    <a
      href={`${base}/`}
      aria-label="Bar-Baridade – Página inicial"
      tabindex="0"
    >
      <img src={logoBarBaridade.src} alt="Logo Bar-Baridade" width="240" height="auto" />
    </a>

    <nav class="nav" aria-label="Navegação principal" id="nav-principal">
      <ul class="flex" role="list">
        <li role="listitem"><a href={`${base}/`} tabindex="0">Início</a></li>
        <li role="listitem"><a href={`${base}/sobre`} tabindex="0">Sobre o Bar</a></li>
        <li role="listitem"><a href={`${base}/menu`} tabindex="0">Nosso Cardápio</a></li>
        <li role="listitem"><a href={`${base}/calendario`} tabindex="0">Calendário de Eventos</a></li>
        <li role="listitem">
          <BtnDefault label="Faça uma reserva" className="nav-menu-button" />
        </li>
      </ul>
    </nav>

    <button
      class="btn-menu-hamburger"
      id="btn-hamburger"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
      aria-controls="nav-principal"
      tabindex="0"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  header {
    padding: 16px 0;
    background-color: #000000df;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 4;

    div {
      justify-content: space-between;

      img {
        width: 240px;
      }

      ul {
        a {
          font-family: "Roboto", sans-serif;
          font-weight: 600;
          font-size: 16px;
          text-transform: uppercase;
          cursor: pointer;
          transition: all 0.2s;
          padding: 16px 24px;
          color: var(--white);

          &:hover {
            color: var(--primary-color);
          }
        }

        .nav-menu-button {
          margin-left: 24px;
        }
      }

      .btn-menu-hamburger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        border-radius: 6px;

        span {
          display: block;
          width: 20px;
          height: 2px;
          background-color: var(--white);
          margin: 4px 0;
          border-radius: 100%;
        }
      }
    }
  }

  @media (max-width: 1280px) {
    header {
      padding: 12px 16px;

      div {
        flex-direction: row;

        img {
          width: 140px;
        }

        nav {
          display: none;
          position: absolute;
          left: 0;
          top: 77px;
          width: 100%;
          padding: 40px;
          background-color: var(--secondary-color);

          ul {
            flex-direction: column !important;
            gap: 24px;

            a {
              font-size: 14px;
            }
          }

          .nav-menu-button {
            display: block;
            margin-left: 0;
          }
        }

        nav.open {
          display: block;
        }

        .btn-menu-hamburger {
          display: block;
        }
      }
    }
  }

  @media (max-width: 720px) {
    header {
      div {
        flex-direction: row !important;

        nav {
          padding: 24px 0 40px;
          background-color: var(--secondary-color);

          ul {
            gap: 16px;
          }
        }

        nav.open {
          display: block;
        }

        .btn-menu-hamburger {
          display: block;
        }
      }
    }
  }
</style>

<script>
  const btn = document.getElementById('btn-hamburger');
  const nav = document.querySelector('.nav');

  function toggleMenu() {
    if (nav && btn) {
      const isOpen = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
      btn.setAttribute('aria-label', isOpen ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
    }
  }

  btn?.addEventListener('click', toggleMenu);

  // Fechar menu ao pressionar ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open') && btn) {
      nav.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Abrir menu de navegação');
      btn.focus();
    }
  });

  // Compatibilidade com onclick inline legado
  (window as any).openMenu = toggleMenu;
</script>
