---
import BtnDefault from "./shared/BtnDefault.astro";
import imgCalendario from "../assets/banda-tocando-no-bar.jpg";
---

<section class="flex flex-col md:flex-row w-full">
  <div
    class="w-full md:w-1/2 h-[40vh] md:h-[90vh] bg-center bg-no-repeat bg-cover"
    style={`background-image: url(${imgCalendario.src});`}
  >
  </div>
  <div
    class="w-full md:w-1/2 px-4 md:px-0 py-16 md:py-0 flex flex-col justify-center items-center"
  >
    <h2
      class="text-2xl md:text-4xl lg:text-5xl font-semibold uppercase text-(--primary-color) mb-3"
    >
      Calendário de Shows
    </h2>
    <h3
      class="text-lg md:text-2xl lg:text-3xl font-semibold text-(--white) mb-16"
    >
      Dezembro 2025
    </h3>
    <div class="text-(--white) flex flex-col gap-10">
      <div class="w-full flex flex-col gap-3 items-start">
        <p class="font-semibold md:text-xl">
          <span class="underline">Quinta • 06/12</span> - “Os Bons de Copo”
        </p>
        <p class="text-sm md:text-[16px]">
          Jazz, bossa e improviso pra quem entende que ritmo também se bebe.
        </p>
      </div>
      <div class="w-full flex flex-col gap-3 items-start">
        <p class="font-semibold md:text-xl">
          <span class="underline">Sexta • 07/12</span> - “Vintage 82”
        </p>
        <p class="text-sm md:text-[16px]">
          Rock clássico com alma jovem e solos que combinam com whisky on the
          rocks.
        </p>
      </div>
      <div class="w-full flex flex-col gap-3 items-start">
        <p class="font-semibold md:text-xl">
          <span class="underline">Sábado • 08/12</span> - “Marina & Os Destemperados”
        </p>
        <p class="text-sm md:text-[16px]">
          MPB moderna e risadas entre um gole e outro.
        </p>
      </div>
      <BtnDefault
        label="Ver todos os eventos"
        ref="calendario"
        colorScheme="tertiary"
      />
    </div>
  </div>
</section>
