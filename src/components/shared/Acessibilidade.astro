---
---

<div id="a11y-widget">
  <button
    id="a11y-btn"
    aria-label="Abrir painel de acessibilidade"
    aria-expanded="false"
    aria-controls="a11y-painel"
    tabindex="0"
  >
  <img src="/src/assets/icon-acessibilidade.png" alt="">

  </button>

  <div id="a11y-painel" role="dialog" aria-label="Opções de acessibilidade" hidden>

    <div class="a11y-cabecalho">
      <span>Acessibilidade</span>
      <button id="a11y-fechar" aria-label="Fechar painel de acessibilidade">✕</button>
    </div>

    <div class="a11y-grupo" role="group" aria-labelledby="label-texto">
      <p id="label-texto">Tamanho do texto</p>
      <div class="a11y-linha">
        <button id="btn-texto-diminuir" aria-label="Diminuir texto">A−</button>
        <span id="texto-valor" aria-live="polite">100%</span>
        <button id="btn-texto-aumentar" aria-label="Aumentar texto">A+</button>
        <button id="btn-texto-padrao" aria-label="Tamanho padrão do texto">↺</button>
      </div>
    </div>

    <div class="a11y-grupo" role="group" aria-labelledby="label-contraste">
      <p id="label-contraste">Contraste</p>
      <div class="a11y-botoes">
        <button class="a11y-opcao ativo" id="btn-contraste-normal" aria-pressed="true">Padrão</button>
        <button class="a11y-opcao" id="btn-contraste-alto" aria-pressed="false">Alto contraste</button>
      </div>
    </div>

    <div class="a11y-grupo" role="group" aria-labelledby="label-espacamento">
      <p id="label-espacamento">Espaçamento</p>
      <div class="a11y-botoes">
        <button class="a11y-opcao ativo" id="btn-espacamento-normal" aria-pressed="true">Padrão</button>
        <button class="a11y-opcao" id="btn-espacamento-espacado" aria-pressed="false">Espaçado</button>
      </div>
    </div>

    <div class="a11y-grupo" role="group" aria-labelledby="label-cursor">
      <p id="label-cursor">Cursor</p>
      <div class="a11y-botoes">
        <button class="a11y-opcao ativo" id="btn-cursor-normal" aria-pressed="true">Padrão</button>
        <button class="a11y-opcao" id="btn-cursor-grande" aria-pressed="false">Grande</button>
      </div>
    </div>

    <div class="a11y-grupo" role="group" aria-labelledby="label-links">
      <p id="label-links">Destacar links</p>
      <div class="a11y-botoes">
        <button class="a11y-opcao ativo" id="btn-links-off" aria-pressed="true">Desligado</button>
        <button class="a11y-opcao" id="btn-links-on" aria-pressed="false">Ligado</button>
      </div>
    </div>

    <div class="a11y-grupo" role="group" aria-labelledby="label-animacoes">
      <p id="label-animacoes">Animações</p>
      <div class="a11y-botoes">
        <button class="a11y-opcao ativo" id="btn-anim-on" aria-pressed="true">Ativadas</button>
        <button class="a11y-opcao" id="btn-anim-off" aria-pressed="false">Desativadas</button>
      </div>
    </div>

    <button id="btn-resetar" aria-label="Resetar todas as configurações de acessibilidade">
      Resetar tudo
    </button>

  </div>
</div>

<style>
  #a11y-widget {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 9999;
    font-family: 'Roboto', sans-serif;
    font-size: 14px;
  }

  #a11y-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #eab633;
    color: #000;
    border: 2px solid #000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }
  #a11y-btn:focus-visible { outline: 3px solid #eab633; outline-offset: 3px; }

  #a11y-painel {
    position: absolute;
    bottom: 60px;
    right: 0;
    width: 280px;
    background: #1c1c1c;
    border: 3px solid #eab633;
    border-radius: 10px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 6px 24px rgba(0,0,0,0.6);
  }
  #a11y-painel[hidden] { display: none; }

  .a11y-cabecalho {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    border-bottom: 1px solid #333;
  }
  .a11y-cabecalho span {
    font-weight: 700;
    font-size: 13px;
    color: #eab633;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  #a11y-fechar {
    background: none;
    border: none;
    color: #999;
    font-size: 16px;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 4px;
    line-height: 1;
  }
  #a11y-fechar:hover { color: #fff; }
  #a11y-fechar:focus-visible { outline: 2px solid #eab633; outline-offset: 2px; }

  .a11y-grupo > p {
    font-size: 11px;
    font-weight: 600;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 6px;
  }

  .a11y-linha {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .a11y-linha span {
    flex: 1;
    text-align: center;
    color: #fff;
    font-weight: 600;
    font-size: 13px;
  }
  .a11y-linha button {
    background: #2a2a2a;
    border: 1px solid #444;
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    padding: 5px 10px;
    border-radius: 5px;
    cursor: pointer;
  }
  .a11y-linha button:hover { background: #eab633; color: #000; }
  .a11y-linha button:focus-visible { outline: 2px solid #eab633; outline-offset: 2px; }

  .a11y-botoes {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .a11y-opcao {
    background: #2a2a2a;
    border: 1px solid #444;
    color: #ccc;
    font-size: 12px;
    padding: 5px 12px;
    border-radius: 5px;
    cursor: pointer;
    font-family: 'Roboto', sans-serif;
  }
  .a11y-opcao:hover { background: #3a3a3a; color: #fff; }
  .a11y-opcao:focus-visible { outline: 2px solid #eab633; outline-offset: 2px; }
  .a11y-opcao.ativo {
    background: #eab633;
    color: #000;
    border-color: #eab633;
    font-weight: 700;
  }

  #btn-resetar {
    background: transparent;
    border: 1px solid #444;
    color: #777;
    font-size: 11px;
    padding: 7px;
    border-radius: 5px;
    cursor: pointer;
    width: 100%;
    font-family: 'Roboto', sans-serif;
    margin-top: 2px;
  }
  #btn-resetar:hover { background: #2a2a2a; color: #fff; }
  #btn-resetar:focus-visible { outline: 2px solid #eab633; outline-offset: 2px; }

  @media (max-width: 720px) {
    #a11y-widget { bottom: 16px; right: 16px; }
    #a11y-painel { width: 260px; }
  }
</style>

<script>
  const html = document.documentElement;
  const painel = document.getElementById('a11y-painel');
  const btnAbrir = document.getElementById('a11y-btn');
  const btnFechar = document.getElementById('a11y-fechar');
  const widget = document.getElementById('a11y-widget');

  // Abrir / fechar
  btnAbrir?.addEventListener('click', () => {
    const aberto = !painel?.hidden;
    if (aberto) {
      fechar();
    } else {
      painel?.removeAttribute('hidden');
      btnAbrir.setAttribute('aria-expanded', 'true');
      btnFechar?.focus();
    }
  });

  function fechar() {
    painel?.setAttribute('hidden', '');
    btnAbrir?.setAttribute('aria-expanded', 'false');
    btnAbrir?.focus();
  }

  btnFechar?.addEventListener('click', fechar);

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !painel?.hidden) fechar();
  });

  document.addEventListener('click', e => {
    if (!painel?.hidden && widget && !widget.contains(e.target as Node)) fechar();
  });

  // Utilitário: marca um botão como ativo num grupo
  function setAtivo(idAtivo: string, ids: string[]) {
    ids.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      const ativo = id === idAtivo;
      el.setAttribute('aria-pressed', String(ativo));
      el.classList.toggle('ativo', ativo);
    });
  }

  // ── Tamanho do texto ──
  let tamanho = 100;
  const textoValor = document.getElementById('texto-valor');

  function setTamanho(v: number) {
    tamanho = Math.max(70, Math.min(160, v));
    html.style.fontSize = tamanho + '%';
    if (textoValor) textoValor.textContent = tamanho + '%';
    salvar('a11y-tamanho', String(tamanho));
  }

  document.getElementById('btn-texto-aumentar')?.addEventListener('click', () => setTamanho(tamanho + 10));
  document.getElementById('btn-texto-diminuir')?.addEventListener('click', () => setTamanho(tamanho - 10));
  document.getElementById('btn-texto-padrao')?.addEventListener('click', () => setTamanho(100));

  // ── Contraste ──
  function setContraste(modo: string) {
    html.classList.toggle('alto-contraste', modo === 'alto');
    setAtivo(modo === 'alto' ? 'btn-contraste-alto' : 'btn-contraste-normal',
             ['btn-contraste-normal', 'btn-contraste-alto']);
    salvar('a11y-contraste', modo);
  }

  document.getElementById('btn-contraste-normal')?.addEventListener('click', () => setContraste('normal'));
  document.getElementById('btn-contraste-alto')?.addEventListener('click', () => setContraste('alto'));

  // ── Espaçamento ──
  function setEspacamento(modo: string) {
    html.classList.toggle('espacado', modo === 'espacado');
    setAtivo(modo === 'espacado' ? 'btn-espacamento-espacado' : 'btn-espacamento-normal',
             ['btn-espacamento-normal', 'btn-espacamento-espacado']);
    salvar('a11y-espacamento', modo);
  }

  document.getElementById('btn-espacamento-normal')?.addEventListener('click', () => setEspacamento('normal'));
  document.getElementById('btn-espacamento-espacado')?.addEventListener('click', () => setEspacamento('espacado'));

  // ── Cursor ──
  function setCursor(modo: string) {
    html.classList.toggle('cursor-grande', modo === 'grande');
    setAtivo(modo === 'grande' ? 'btn-cursor-grande' : 'btn-cursor-normal',
             ['btn-cursor-normal', 'btn-cursor-grande']);
    salvar('a11y-cursor', modo);
  }

  document.getElementById('btn-cursor-normal')?.addEventListener('click', () => setCursor('normal'));
  document.getElementById('btn-cursor-grande')?.addEventListener('click', () => setCursor('grande'));

  // ── Destacar links ──
  function setLinks(modo: string) {
    html.classList.toggle('destacar-links', modo === 'on');
    setAtivo(modo === 'on' ? 'btn-links-on' : 'btn-links-off',
             ['btn-links-off', 'btn-links-on']);
    salvar('a11y-links', modo);
  }

  document.getElementById('btn-links-off')?.addEventListener('click', () => setLinks('off'));
  document.getElementById('btn-links-on')?.addEventListener('click', () => setLinks('on'));

  // ── Animações ──
  function setAnimacoes(modo: string) {
    html.classList.toggle('sem-animacoes', modo === 'off');
    setAtivo(modo === 'off' ? 'btn-anim-off' : 'btn-anim-on',
             ['btn-anim-on', 'btn-anim-off']);
    salvar('a11y-animacoes', modo);
  }

  document.getElementById('btn-anim-on')?.addEventListener('click', () => setAnimacoes('on'));
  document.getElementById('btn-anim-off')?.addEventListener('click', () => setAnimacoes('off'));

  // ── Resetar tudo ──
  document.getElementById('btn-resetar')?.addEventListener('click', () => {
    setTamanho(100);
    setContraste('normal');
    setEspacamento('normal');
    setCursor('normal');
    setLinks('off');
    setAnimacoes('on');
    ['a11y-tamanho','a11y-contraste','a11y-espacamento','a11y-cursor','a11y-links','a11y-animacoes']
      .forEach(k => localStorage.removeItem(k));
  });

  // ── localStorage ──
  function salvar(k: string, v: string) { try { localStorage.setItem(k, v); } catch {} }

  function restaurar() {
    const t = localStorage.getItem('a11y-tamanho');
    if (t) setTamanho(parseInt(t));

    const c = localStorage.getItem('a11y-contraste');
    if (c) setContraste(c);

    const e = localStorage.getItem('a11y-espacamento');
    if (e) setEspacamento(e);

    const cu = localStorage.getItem('a11y-cursor');
    if (cu) setCursor(cu);

    const l = localStorage.getItem('a11y-links');
    if (l) setLinks(l);

    const a = localStorage.getItem('a11y-animacoes');
    if (a) setAnimacoes(a);
  }

  restaurar();
</script>
